{
  "manifest_version": 3,
  "name": "Remove Monday AI",
  "version": "1.0.0",
  "description": "Hide Monday.com's AI controls. Click the toolbar icon to show or hide them instantly.",
  "minimum_chrome_version": "109",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Monday AI controls are hidden — click to show",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [{
    "matches": ["https://monday.com/*", "https://*.monday.com/*"],
    "css": ["hide-ai.css"],
    "js": ["content.js"],
    "run_at": "document_start",
    "all_frames": true
  }]
}
